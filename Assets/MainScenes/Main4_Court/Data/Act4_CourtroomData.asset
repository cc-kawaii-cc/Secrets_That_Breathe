      desc: "\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E04\u0E27\u0E32\u0E21\u0E08\u0E33\u0E08\u0E32\u0E01\u0E40\u0E0B\u0E1F\u0E43\u0E19\u0E40\u0E1E\u0E19\u0E15\u0E4C\u0E40\u0E2E\u0E32\u0E2A\u0E4C
