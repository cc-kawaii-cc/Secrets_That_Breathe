    name: "\u0E04\u0E33\u0E16\u0E32\u0E21\u0E19\u0E33"
    help: "\u0E04\u0E33\u0E16\u0E32\u0E21\u0E17\u0E35\u0E48\u0E43\u0E2A\u0E48\u0E04\u0E33\u0E15\u0E2D\u0E1A\u0E44\u0E27\u0E49\u0E43\u0E2B\u0E49\u0E43\u0E19\u0E15\u0E31\u0E27
